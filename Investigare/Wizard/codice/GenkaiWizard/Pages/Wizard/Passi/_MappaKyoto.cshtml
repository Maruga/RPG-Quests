<div class="wz-mappa2">
    <div class="wz-mappa2-cont" id="wz-mappa2-cont">
        <img id="wz-mappa2-img" alt="Mappa del caso" draggable="false" />
        <div id="wz-mappa2-pins"></div>
    </div>
    <div id="wz-mappa-info" class="wz-info" hidden></div>
    <div class="wz-mappa2-bar">
        <span class="wz-nota" id="wz-mappa2-hint">Tocca un perno per i dettagli della zona.</span>
        <button type="button" class="wz-btn wz-mini" id="wz-mappa2-vista" title="Nasconde quello che hai marcato 🙈 segreto">👁 Vista giocatori</button>
        <button type="button" class="wz-btn wz-mini" id="wz-mappa2-calibra">✎ Zone del caso</button>
        <label class="wz-btn wz-mini" for="wz-mappa2-file">🖼 Immagine del caso</label>
        <input type="file" id="wz-mappa2-file" accept="image/png,image/jpeg" hidden />
    </div>
    <div id="wz-mappa2-editor" class="wz-info" hidden></div>
</div>

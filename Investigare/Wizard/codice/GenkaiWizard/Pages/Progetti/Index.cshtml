@page
@model GenkaiWizard.Pages.Progetti.IndexModel
@{
    ViewData["Title"] = "I miei casi";
}

<div class="wz-progetti">
    <h1>I miei casi</h1>

    @* fase di test (decisione utente 2026-08-31): si sfoglia il caso dimostrativo,
       la creazione è aperta solo all'email in Casi:Creatore *@
    <div class="wz-info" style="border-color:#b08d2f">
        🧪 <strong>Il wizard dei casi è in fase di test.</strong>
        Per ora potete <strong>sfogliare il caso dimostrativo</strong> qui sotto — un'avventura completa,
        costruita col wizard, in sola lettura: quindici schermate dal cadavere al calendario vivo.
        La creazione dei vostri casi apre a breve@(Model.PuoCreare ? "" : " — intanto l'investigatore si crea già").
    </div>

    @if (Model.PuoCreare)
    {
        <form method="post" asp-page-handler="Crea" class="wz-nuovo">
            <input type="text" name="titolo" maxlength="120" placeholder="Titolo del nuovo caso (opzionale)" />
            <button type="submit" class="wz-btn wz-btn-primario">+ Nuovo caso</button>
        </form>
    }

    @if (Model.Progetti.Count == 0)
    {
        <p class="wz-vuoto">Nessun caso ancora.</p>
    }
    else
    {
        <ul class="wz-lista">
            @foreach (var p in Model.Progetti)
            {
                <li class="wz-card">
                    <a class="wz-card-main" asp-page="/Wizard/Index" asp-route-id="@p.Id" asp-route-passo="@(p.Demo ? 0 : p.PassoCorrente)">
                        <strong>@p.Titolo</strong>@if (p.Demo){<span class="wz-bollo-demo">Demo · sola lettura</span>}
                        @{ var totSchermate = GenkaiWizard.Pages.Wizard.IndexModel.UltimaSchermata + 1; }
                        <span class="wz-meta">@(p.Demo ? $"un caso completo da sfogliare · {totSchermate} schermate" : $"passo {p.PassoCorrente + 1}/{totSchermate} · agg. {p.AggiornatoIl.ToLocalTime():dd/MM HH:mm}")</span>
                        @if (!p.Demo)
                        {
                            <span class="wz-barra"><span style="width:@((p.PassoCorrente + 1) * 100 / totSchermate)%"></span></span>
                        }
                    </a>
                    @if (!p.Demo)
                    {
                        <form method="post" asp-page-handler="Elimina" asp-route-id="@p.Id"
                              onsubmit="return confirm('Eliminare definitivamente questo caso?');">
                            <button type="submit" class="wz-btn-x" title="Elimina">✕</button>
                        </form>
                    }
                </li>
            }
        </ul>
    }
</div>

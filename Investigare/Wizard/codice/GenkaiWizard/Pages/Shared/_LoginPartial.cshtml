@using Microsoft.AspNetCore.Identity
@inject SignInManager<IdentityUser> SignInManager
@inject UserManager<IdentityUser> UserManager
@model string?
@{
    /* Due usi: senza model = voci dentro il menu (su telefono), model "desktop" = pillola «Accedi» a destra
       nella barra (solo da 760px in su, come nella home del sito). */
    var desktop = Model == "desktop";
}
@if (desktop)
{
    if (SignInManager.IsSignedIn(User))
    {
        <a class="accesso" asp-area="" asp-page="/Account/Index" title="Il tuo account">@User.Identity?.Name</a>
    }
    else
    {
        <a class="accesso" asp-area="" asp-page="/Account/Login">Accedi</a>
    }
}
else if (SignInManager.IsSignedIn(User))
{
    <a class="solo-mob" asp-area="" asp-page="/Account/Index" title="Il tuo account">@User.Identity?.Name</a>
    <form asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="/">
        <button type="submit" class="voce">Esci</button>
    </form>
}
else
{
    <a asp-area="" asp-page="/Account/Registrati">Registrati</a>
    <a class="solo-mob" asp-area="" asp-page="/Account/Login">Accedi</a>
}

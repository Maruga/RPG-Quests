@page
@model GenkaiWizard.Pages.Pg.IndexModel
@{
    ViewData["Title"] = "I miei personaggi";
}

<div class="wz-progetti">
    <h1>I miei personaggi</h1>

@if (!string.IsNullOrEmpty(Model.Avviso))
{
    <div class="wz-info" style="border-color:#8b1a1a">@Model.Avviso</div>
}

    @if (GenkaiWizard.Services.Ospite.SenzaAccount(HttpContext))
    {
        <div class="pg-ospite">
            <p>
                <strong>Puoi cominciare subito, senza registrarti.</strong>
                Il tuo investigatore resta salvato qui, su questo browser.
                Con un account lo ritrovi anche dal telefono o da un altro computer.
            </p>
            <p class="wz-nota">
                ⚠ Senza account la scheda è legata ai cookie di questo browser:
                <strong>se li cancelli, l'investigatore non è più recuperabile</strong>.
                Registrati (gratis) per metterlo al sicuro.
            </p>
            <p class="pg-ospite-azione">
                <a class="wz-btn wz-mini wz-btn-primario" asp-area="" asp-page="/Account/Registrati">Crea un account</a>
                <a class="wz-btn wz-mini" asp-area="" asp-page="/Account/Login">Ho già un account</a>
                <span class="wz-nota">Quello che hai già creato si sposta da solo.</span>
            </p>
        </div>
    }

    <form method="post" asp-page-handler="Crea" class="wz-nuovo">
        <input type="text" name="nome" maxlength="120" placeholder="Alias — un nome per ricordartelo (non è il nome del personaggio)" />
        <button type="submit" class="wz-btn wz-btn-primario">+ Nuovo personaggio</button>
    </form>

    @if (Model.Personaggi.Count == 0)
    {
        <p class="wz-vuoto">Nessun personaggio.</p>
    }
    else
    {
        var nomiPassi = new[] { "Il tè", "Termini", "Identità", "Attributi", "Senmon", "Gou", "Ki", "Storia", "Kage", "Enja", "Carattere", "Squadra", "Riepilogo" };
        <ul class="wz-lista">
            @foreach (var p in Model.Personaggi)
            {
                var passo = Model.PassoPg.GetValueOrDefault(p.Id, 0);
                <li class="wz-card">
                    <a class="wz-card-main" asp-page="/Pg/Scheda" asp-route-id="@p.Id">
                        <strong>@p.Nome</strong>@if (Model.NomiPg.TryGetValue(p.Id, out var npg) && npg != "" && npg != p.Nome)
                        {<text> — @npg</text>}
                        <span class="wz-meta">agg. @p.AggiornatoIl.ToLocalTime().ToString("dd/MM HH:mm") · arrivato a <strong>@nomiPassi[passo]</strong> (@passo/12)</span>
                        <span class="pg-avanz"><span style="width:@(passo * 100 / 12)%"></span></span>
                    </a>
                    <div class="wz-card-azioni">
                        <a class="wz-icobtn" asp-page="/Pg/Stampa" asp-route-id="@p.Id" title="Vista stampabile">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9V3h12v6"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8" rx="1"/></svg>
                        </a>
                        <form method="post" asp-page-handler="Elimina" asp-route-id="@p.Id"
                              onsubmit="return confirm('Eliminare definitivamente questo personaggio?');">
                            <button type="submit" class="wz-icobtn rosso" title="Elimina">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 6h18"/><path d="M8 6V4a1 1 0 0 1 1-1h6a1 1 0 0 1 1 1v2"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
                            </button>
                        </form>
                    </div>
                </li>
            }
        </ul>
    }
</div>
